{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/wake-claude.sh",
            "asyncRewake": true,
            "timeout": 28800
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/reidentify-claude.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
