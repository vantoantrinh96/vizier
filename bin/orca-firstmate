#!/usr/bin/env bash
# orca-firstmate — CLI cài đặt và chẩn đoán.
#
# LUẬT CỨNG: script này CHỈ chạy lúc cài và lúc chẩn đoán. Không đường runtime
# nào được gọi nó. Sau khi cài, first mate nói chuyện thẳng với `orca`.
set -u

# $0 CÓ THỂ LÀ SYMLINK. `install.sh` cài CLI này đúng bằng một symlink trên
# PATH, nên đó là đường gọi thật duy nhất — và khi đó `dirname "$0"` trỏ vào
# thư mục bin trên PATH, không phải nơi script thật nằm. Hậu quả đã tái hiện
# được: REPO_DIR sai -> source lib thất bại -> `ofm_home` không tồn tại ->
# `$(ofm_home)` rỗng -> mọi đường dẫn suy ra từ nó trỏ sai, và guard chống tự
# huỷ quay sang thao tác trên thư mục hiện hành của người gọi. Đi hết chuỗi
# link TRƯỚC khi suy ra bất cứ đường dẫn nào.
_self=$0
_hops=0
while [ -L "$_self" ] && [ "$_hops" -lt 16 ]; do
  _t=$(readlink "$_self") || break
  case "$_t" in
    /*) _self=$_t ;;
    *)  _self="$(dirname "$_self")/$_t" ;;
  esac
  _hops=$((_hops + 1))
done
# Chạm trần thì BÁO LỖI, không đi tiếp với đường dẫn giải dở. Đi tiếp là suy
# thoái im lặng — đúng loại lỗi đã cắn dự án này ba lần (cd "" thành no-op,
# trap tín hiệu chạy tiếp, guard nối chuỗi trước khi kiểm) — và ở đây nó có thể
# cho ra một REPO_DIR sai mà vẫn hợp lệ.
[ -L "$_self" ] && {
  printf 'error: chuỗi symlink quá sâu (>16 hop) từ %s\n' "$0" >&2; exit 2; }
SELF_DIR="$(cd "$(dirname "$_self")" 2>/dev/null && pwd)" || {
  printf 'error: không xác định được thư mục của script\n' >&2; exit 2; }
REPO_DIR="$(cd "$SELF_DIR/.." 2>/dev/null && pwd)" || {
  printf 'error: không xác định được thư mục gốc\n' >&2; exit 2; }

# Source THẤT BẠI PHẢI CHẾT. Bash chỉ in cảnh báo rồi chạy tiếp, và `set -u`
# không bắt hàm không tồn tại — đó chính là cách một `ofm_home` khuyết biến
# thành đường dẫn rỗng và guard trỏ sai chỗ.
[ -r "$REPO_DIR/lib/ofm-home.sh" ] || {
  printf 'error: không đọc được %s/lib/ofm-home.sh\n' "$REPO_DIR" >&2; exit 2; }
# shellcheck source=/dev/null
. "$REPO_DIR/lib/ofm-home.sh"

OFM_HOME_DIR=$(ofm_home)
[ -n "$OFM_HOME_DIR" ] || { printf 'error: home rỗng\n' >&2; exit 2; }

# Đường dẫn chuẩn hoá CHỈ khi thư mục thật sự tồn tại. `cd ""` là no-op im lặng
# trong bash và trả về thư mục hiện hành — đúng cái đã biến guard thành mìn.
_canon() {  # <path> -> đường dẫn chuẩn nếu tồn tại, rỗng nếu không
  [ -n "$1" ] && [ -d "$1" ] || return 0
  (cd "$1" 2>/dev/null && pwd)
}

DIST="$OFM_HOME_DIR/dist"
CLAUDE_SKILLS="${OFM_CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}"
CURSOR_HOOKS="${OFM_CURSOR_HOOKS_JSON:-$HOME/.cursor/hooks.json}"

_sync_dist() {
  # TỪ CHỐI khi đang chạy từ chính bản đã cài: _sync_dist xoá $DIST rồi chép từ
  # $REPO_DIR, mà khi chạy từ dist thì hai đường dẫn đó là một -> tự huỷ.
  # So sánh trên đường dẫn CHUẨN của thư mục CÓ THẬT. Nếu dist chưa tồn tại thì
  # REPO_DIR không thể nằm trong nó, nên guard không cần nổ — và quan trọng hơn,
  # không có nhánh nào để một giá trị rỗng lọt vào phép so.
  local dist_canon
  dist_canon=$(_canon "$DIST")
  if [ -n "$dist_canon" ]; then
    case "$REPO_DIR/" in
      "$dist_canon"/*|"$dist_canon/")
        printf 'refused: đang chạy từ bản đã cài (%s).\n' "$REPO_DIR" >&2
        printf '  chạy install/update từ source checkout: %s/src/bin/orca-firstmate install\n' "$OFM_HOME_DIR" >&2
        return 1 ;;
    esac
  fi
  mkdir -p "$DIST" || return 1
  rm -rf "${DIST:?}/"*
  local item
  for item in lib hooks skills commands bin .claude-plugin; do
    [ -e "$REPO_DIR/$item" ] || continue
    cp -R "$REPO_DIR/$item" "$DIST/" || return 1
  done
  printf 'payload -> %s\n' "$DIST"
}

cmd_doctor() {
  local problems=0 status reachable state caps
  for t in orca jq git gh; do
    command -v "$t" >/dev/null 2>&1 || {
      case "$t" in
        orca) printf 'MISSING: orca (install: brew install orca)\n' ;;
        jq)   printf 'MISSING: jq (install: brew install jq)\n' ;;
        git)  printf 'MISSING: git (install: brew install git)\n' ;;
        gh)   printf 'MISSING: gh (install: brew install gh && gh auth login)\n' ;;
      esac
      problems=$((problems + 1))
    }
  done
  if command -v orca >/dev/null 2>&1; then
    status=$(orca status --json 2>/dev/null)
    reachable=$(printf '%s' "$status" | jq -r '.result.reachable // false' 2>/dev/null)
    state=$(printf '%s' "$status" | jq -r '.result.state // "unknown"' 2>/dev/null)
    caps=$(printf '%s' "$status" | jq -r '(.result.capabilities // []) | join(",")' 2>/dev/null)
    if [ "$reachable" != "true" ] || [ "$state" != "ready" ]; then
      printf 'NOT_READY: Orca reachable=%s state=%s (fix: orca open, rồi chờ app sẵn sàng)\n' "$reachable" "$state"
      problems=$((problems + 1))
    fi
    # Membership CHÍNH XÁC, không phải substring: `*orchestration.contract.v1*`
    # sẽ khớp cả `orchestration.contract.v10` và `x-orchestration.contract.v1`,
    # tức báo đạt trong khi capability thật vắng mặt.
    if ! printf '%s' "$status" | jq -e --arg c orchestration.contract.v1 \
         '((.result.capabilities // []) | index($c)) != null' >/dev/null 2>&1; then
      printf 'NOT_READY: Orca thiếu capability orchestration.contract.v1 (fix: cập nhật app Orca)\n'
      problems=$((problems + 1))
    fi
  fi
  if [ -z "${OFM_SKIP_GH_AUTH:-}" ] && command -v gh >/dev/null 2>&1 && ! gh auth status >/dev/null 2>&1; then
    printf 'NOT_READY: gh chưa đăng nhập (fix: gh auth login)\n'
    problems=$((problems + 1))
  fi
  # FIX 6 — doctor TRƯỚC ĐÂY CHỈ KIỂM TOOLCHAIN, chưa từng hỏi "có gì được cài
  # chưa". Một máy đã qua doctor+install từ lâu mà bản Claude bị gỡ tay (hoặc
  # chưa từng cài) vẫn báo "ok" ở đây trong khi /firstmate không tồn tại. Đây
  # là NOTE, KHÔNG PHẢI problem: không cộng vào `problems`, không kéo rc xuống
  # 1 — một máy chỉ dùng MỘT trong hai harness là hợp lệ (report, không refuse).
  if [ ! -d "$CLAUDE_SKILLS/orca-firstmate" ]; then
    printf 'NOTE: chưa cài adapter Claude ở %s (fix: orca-firstmate install --harness claude)\n' "$CLAUDE_SKILLS"
  fi
  # `verify` của adapter Cursor trước đây là dead code: không nơi nào gọi nó
  # ngoài test. Gọi nó ở đây khi cursor-agent CÓ MẶT trên máy — đó là dấu hiệu
  # một entry Cursor ĐƯỢC MONG ĐỢI tồn tại đúng hình dạng, không phải ép buộc
  # phải cài Cursor (máy không có cursor-agent thì không kiểm gì cả, im lặng
  # hợp lệ). Chạy adapter từ REPO_DIR (luôn có sẵn cạnh CLI này), không từ
  # $DIST: doctor không gọi _sync_dist nên $DIST/bin có thể chưa tồn tại lần
  # đầu chạy, còn logic verify chỉ so sánh CHUỖI đường dẫn $DIST kỳ vọng, nên
  # không cần $DIST thật sự có mặt trên đĩa.
  if command -v cursor-agent >/dev/null 2>&1; then
    if ! bash "$REPO_DIR/bin/ofm-adapter-cursor.sh" verify "$DIST" "$CURSOR_HOOKS" >/dev/null 2>&1; then
      printf 'NOTE: cursor-agent có trên máy nhưng entry Cursor ở %s thiếu hoặc sai hình dạng (fix: orca-firstmate install --harness cursor)\n' "$CURSOR_HOOKS"
    fi
  fi
  if [ "$problems" -eq 0 ]; then
    printf 'doctor: ok — orca ready, jq/git/gh sẵn sàng\n'
    return 0
  fi
  return 1
}

# FIX 9 — MỘT `install` TRẦN KHÔNG ĐƯỢC ĐỤNG CURSOR. Nửa Cursor CHƯA CÓ đường
# kích hoạt: `ofm-activate.sh` đọc CLAUDE_CODE_SESSION_ID, một biến chỉ Claude
# Code có, nên một entry Cursor cài "mặc định kèm theo" chỉ đọc lock rồi
# exit 0 mãi mãi — KHÔNG CHỨC NĂNG — trong khi vẫn nhận trọn rủi ro lớn nhất
# của distro: ghi vào ~/.cursor/hooks.json, file Orca đang dùng chung. Bản cũ
# coi "cài cả hai nếu cả hai có mặt" là default (`want=all`); giờ default
# CHỈ LÀ claude. Muốn Cursor phải xin tường minh bằng `--harness cursor`.
cmd_install() {
  local want=claude explicit=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --harness) want=${2:?--harness cần giá trị}; explicit=1; shift 2 ;;
      *) printf 'unknown flag: %s\n' "$1" >&2; return 2 ;;
    esac
  done
  case "$want" in
    claude|cursor) ;;
    *) printf 'error: harness "%s" chưa hỗ trợ. v1 chỉ có claude và cursor.\n' "$want" >&2; return 1 ;;
  esac
  _sync_dist || return 1
  local did=0
  if [ "$want" = claude ]; then
    # Không ép cài khi bare install (explicit=0) và máy không có `claude`:
    # gate bằng detect y như bản cũ. `--harness claude` tường minh thì vẫn ép,
    # để captain thấy lỗi thật của adapter thay vì bị detect nuốt mất.
    if bash "$DIST/bin/ofm-adapter-claude.sh" detect >/dev/null 2>&1 || [ "$explicit" -eq 1 ]; then
      bash "$DIST/bin/ofm-adapter-claude.sh" install "$DIST" "$CLAUDE_SKILLS" || return 1
      did=$((did + 1))
      [ "$explicit" -eq 1 ] || \
        printf 'lưu ý: bỏ qua Cursor — install trần chỉ cài Claude. Muốn cài Cursor: orca-firstmate install --harness cursor\n'
    fi
  fi
  if [ "$want" = cursor ]; then
    bash "$DIST/bin/ofm-adapter-cursor.sh" install "$DIST" "$CURSOR_HOOKS" || return 1
    did=$((did + 1))
  fi
  [ "$did" -gt 0 ] || { printf 'không tìm thấy harness nào được hỗ trợ trên máy\n' >&2; return 1; }
  printf 'xong. Mở một phiên mới rồi gõ /firstmate.\n'
}

cmd_unlock() {
  # FIX 4 — KHÔNG CÓ LỐI THOÁT KHỎI MỘT LOCK KẸT-NHƯNG-SỐNG. `CLAUDE_PID` là
  # pid của TIẾN TRÌNH `claude`, không phải của phiên: sau `/clear` hoặc resume,
  # pid đó vẫn còn sống nhưng session_id bên trong nó đã đổi, nên
  # `ofm_lock_matches` không bao giờ khớp lại và `ofm_lock_claim` từ chối vĩnh
  # viễn (đúng thiết kế: "CHỈ liveness quyết định", không đoán chết). Command
  # brief cấm agent tự xoá file lock. Vậy phải có MỘT cửa thoát tường minh, do
  # captain tự gọi khi họ biết chắc phiên cũ đã xong việc — không đoán hộ, chỉ
  # thực hiện đúng việc captain yêu cầu. Không cần tham số: luôn gỡ lock hiện
  # tại, bất kể ai đang giữ.
  local holder pid
  holder=$(ofm_lock_get session_id)
  if [ -z "$holder" ]; then
    printf 'không có lock nào đang giữ\n'
    return 0
  fi
  pid=$(ofm_lock_get pid)
  rm -f "$(ofm_lock_path)"
  printf 'đã gỡ lock: session_id=%s pid=%s\n' "$holder" "$pid"
}

cmd_update() {
  # FIX 7 — `update` TRƯỚC ĐÂY CHỈ LÀ BÍ DANH CỦA `install`: nó chép lại đúng
  # payload đang có trong SRC checkout hiện tại rồi báo "xong", không hề kéo
  # gì mới từ remote. Captain gõ `orca-firstmate update` tưởng đang lên bản
  # mới nhất, nhưng thực ra chỉ đang cài lại y hệt bản cũ — im lặng sai, đúng
  # kiểu lỗi tệ nhất. `git fetch` + `reset --hard origin/HEAD` TRƯỚC khi
  # `_sync_dist` (bên trong cmd_install) chép từ REPO_DIR: chạy qua symlink
  # bootstrap, REPO_DIR ở đây LÀ `$OFM_HOME_DIR/src` (xem chú thích $0 CÓ THỂ
  # LÀ SYMLINK phía trên), nên reset xong rồi mới sync là kéo đúng bản mới vào
  # dist. Cùng công thức với install.sh (POSIX sh) dùng lúc bootstrap — không
  # bịa cách khác cho CLI này.
  local src
  src="$OFM_HOME_DIR/src"
  if [ -d "$src/.git" ]; then
    git -C "$src" fetch --quiet origin || { printf 'error: fetch thất bại tại %s\n' "$src" >&2; return 1; }
    # origin/HEAD có thể chưa được đặt (clone cũ) — hỏi lại remote, lỗi ở đây
    # không chặn, y hệt install.sh.
    git -C "$src" remote set-head origin -a >/dev/null 2>&1 || true
    git -C "$src" reset --quiet --hard origin/HEAD || { printf 'error: reset thất bại tại %s\n' "$src" >&2; return 1; }
  else
    printf 'error: %s không phải git repo, không update được (chạy lại install.sh để bootstrap)\n' "$src" >&2
    return 1
  fi
  cmd_install "$@"
}

cmd_uninstall() {
  [ -d "$DIST" ] && bash "$DIST/bin/ofm-adapter-claude.sh" uninstall "$CLAUDE_SKILLS" >/dev/null 2>&1
  [ -d "$DIST" ] && bash "$DIST/bin/ofm-adapter-cursor.sh" uninstall "$CURSOR_HOOKS" >/dev/null 2>&1
  rm -rf "$DIST"
  # Dọn cả những gì install.sh tạo ra, nếu không captain gỡ xong vẫn còn một
  # lệnh chết trên PATH trỏ vào clone đã mồ côi.
  local bin_link="${OFM_BIN_DIR:-$HOME/.local/bin}/orca-firstmate"
  [ -L "$bin_link" ] && rm -f "$bin_link"
  # KHÔNG xoá thư mục đang chứa chính script này: bash đọc script theo từng
  # đoạn, xoá giữa lúc chạy là hành vi không xác định. In lệnh cho captain.
  local src src_canon
  src="$OFM_HOME_DIR/src"
  src_canon=$(_canon "$src")
  case "$REPO_DIR/" in
    "${src_canon:-$src}"/*|"${src_canon:-$src}/")
      printf 'đã gỡ adapter, payload và symlink. requests/ và projects/ giữ nguyên ở %s\n' "$(ofm_home)"
      printf 'còn lại source checkout (không tự xoá được vì lệnh này đang chạy từ đó):\n'
      printf '  rm -rf %s\n' "$src"
      return 0 ;;
  esac
  rm -rf "$src"
  printf 'đã gỡ adapter, payload, symlink và clone. requests/ và projects/ giữ nguyên ở %s\n' "$(ofm_home)"
}

case "${1:-}" in
  doctor)    shift; cmd_doctor "$@" ;;
  install)   shift; cmd_install "$@" ;;
  update)    shift; cmd_update "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  unlock)    shift; cmd_unlock "$@" ;;
  *) printf 'usage: orca-firstmate install [--harness claude|cursor]|doctor|update|uninstall|unlock\n' >&2; exit 2 ;;
esac
